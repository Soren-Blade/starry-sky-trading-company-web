    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.5.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.9.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
