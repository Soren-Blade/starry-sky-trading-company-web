{
  "name": "starry-sky-trading-company-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "星辰商行前端（Vue 3 + Vite + Pinia，部署于 Vercel）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none test/*.test.js",
    "lint": "eslint src test scripts vite.config.js",
    "lint:fix": "eslint src test scripts vite.config.js --fix",
    "check": "npm run lint && npm test",
    "verify:dev": "node scripts/verify-dev.cjs",
    "verify": "npm run lint && npm test && npm run build && npm run verify:dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.13.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.0.11",
    "vite-plugin-vue-devtools": "^7.7.0"
  }
}
