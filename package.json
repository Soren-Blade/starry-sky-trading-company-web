{
  "name": "starry-sky-trading-company-web",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "星辰商行前端（Vue 3 + Vite + Pinia，部署于 Vercel）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none test/*.test.js",
    "lint": "eslint src test scripts vite.config.js",
    "lint:fix": "eslint src test scripts vite.config.js --fix",
    "check": "npm run lint && npm test",
